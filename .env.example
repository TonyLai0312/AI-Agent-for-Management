# Optional demo database directory; omit to use .data/evox-postgres.
# EVOX_DB_PATH=YOUR_DATABASE_DIRECTORY
# Optional server-side OpenAI drafting uses OPENAI_API_KEY, OPENAI_DRAFT_MODEL and OPENAI_RESEARCH_MODEL.
# Outbound prospect outreach is always manual. Monitoring emails use Gmail, to the test mailbox only.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_DRAFT_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
OPENAI_CONTACT_MODEL=gpt-4.1-mini
OPENAI_MATCH_MODEL=gpt-4.1-mini
GMAIL_ACCESS_TOKEN=YOUR_GMAIL_OAUTH_ACCESS_TOKEN
EMAIL_FROM=AUTHORIZED_GMAIL_ACCOUNT@example.com
EVOX_TEST_RECIPIENT=TEST_MAILBOX@example.com
EVOX_ADMIN_SECRET=YOUR_RANDOM_ADMIN_SECRET_AT_LEAST_32_CHARACTERS
EVOX_ENABLE_MONITOR_TESTS=false
CRON_SECRET=YOUR_RANDOM_SCHEDULER_SECRET
# Hosted accounts: use npm run accounts:setup locally; copy its salted hashes into host secrets.
EVOX_AUTH_MODE=demo
GM_EMAIL=GM_ACCOUNT@example.com
GM_PASSWORD_HASH=YOUR_GENERATED_SCRYPT_HASH
BDR_EMAIL=BDR_ACCOUNT@example.com
BDR_PASSWORD_HASH=YOUR_GENERATED_SCRYPT_HASH
EVOX_SCHEDULER_TEST_ONCE=false
# Optional remote verification inputs; keep these only in your private local environment.
# VERIFY_BASE_URL=https://YOUR_SERVICE.onrender.com
# VERIFY_GM_EMAIL=GM_ACCOUNT@example.com
# VERIFY_GM_PASSWORD=YOUR_PRIVATE_GM_PASSWORD
# VERIFY_BDR_EMAIL=BDR_ACCOUNT@example.com
# VERIFY_BDR_PASSWORD=YOUR_PRIVATE_BDR_PASSWORD
APP_BASE_URL=https://YOUR_DEPLOYED_APP
BDR_TIMEZONE=Asia/Singapore
